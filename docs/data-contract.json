{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PersonalFinanceState",
  "description": "Estructura del estado de FinanzApp que se guarda en localStorage (clave 'finanzapp.state'). Define solo la forma de los datos: los valores derivados (saldos, resumen, presupuestos, ocurrencias) no se guardan y las reglas entre campos las valida storage.validateState (design.md §6).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "accounts", "categories", "transactions", "schedules", "settings"],
  "properties": {
    "schemaVersion": {
      "description": "Versión de la estructura. Las versiones 1 y 2 se migran al iniciar (REQ-072, REQ-090).",
      "const": 3
    },
    "accounts": {
      "type": "array",
      "items": { "$ref": "#/$defs/account" }
    },
    "categories": {
      "type": "array",
      "items": { "$ref": "#/$defs/category" }
    },
    "transactions": {
      "type": "array",
      "items": { "$ref": "#/$defs/transaction" }
    },
    "schedules": {
      "type": "array",
      "items": { "$ref": "#/$defs/schedule" }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "monthlyBudget": { "$ref": "#/$defs/positiveMoney", "description": "Presupuesto total mensual (opcional)." }
      }
    }
  },
  "$defs": {
    "isoDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Fecha YYYY-MM-DD."
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "money": {
      "type": "number",
      "minimum": 0,
      "multipleOf": 0.01,
      "description": "Monto en colones con máximo 2 decimales."
    },
    "positiveMoney": {
      "$ref": "#/$defs/money",
      "exclusiveMinimum": 0
    },
    "accountId": { "type": "string", "pattern": "^acc-" },
    "categoryId": { "type": "string", "pattern": "^cat-" },
    "scheduleId": { "type": "string", "pattern": "^prg-" },

    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type", "archived", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/accountId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "type": { "enum": ["efectivo", "debito", "ahorros", "credito"] },
        "initialBalance": { "$ref": "#/$defs/money", "description": "Solo efectivo, débito y ahorros." },
        "creditLimit": { "$ref": "#/$defs/positiveMoney", "description": "Solo crédito." },
        "cutoffDay": { "type": "integer", "minimum": 1, "maximum": 28, "description": "Solo crédito: día de corte." },
        "paymentDay": { "type": "integer", "minimum": 1, "maximum": 28, "description": "Solo crédito: día de pago." },
        "goalAmount": { "$ref": "#/$defs/positiveMoney", "description": "Solo ahorros: meta de ahorro (opcional)." },
        "goalReason": { "type": "string", "minLength": 1, "maxLength": 60, "description": "Solo ahorros: razón de la meta (opcional)." },
        "archived": { "type": "boolean" },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      }
    },

    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "system"],
      "properties": {
        "id": { "$ref": "#/$defs/categoryId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "kind": { "enum": ["gasto", "ingreso"] },
        "monthlyBudget": { "$ref": "#/$defs/positiveMoney", "description": "Solo gasto: presupuesto mensual (opcional)." },
        "system": { "type": "boolean", "description": "true = categoría del sistema: no se elimina ni cambia de tipo." }
      }
    },

    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "accountId", "amount", "date", "description", "createdAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^mov-" },
        "type": { "enum": ["ingreso", "gasto", "transferencia"] },
        "accountId": { "$ref": "#/$defs/accountId", "description": "Cuenta de origen (gasto, transferencia) o de destino (ingreso)." },
        "toAccountId": { "$ref": "#/$defs/accountId", "description": "Solo transferencia: cuenta destino." },
        "categoryId": { "$ref": "#/$defs/categoryId", "description": "Solo ingreso y gasto." },
        "amount": { "$ref": "#/$defs/positiveMoney" },
        "date": { "$ref": "#/$defs/isoDate" },
        "description": { "type": "string", "minLength": 1, "maxLength": 80 },
        "scheduleId": { "$ref": "#/$defs/scheduleId", "description": "Programación que originó el movimiento (opcional)." },
        "occurrenceDate": { "$ref": "#/$defs/isoDate", "description": "Fecha de la ocurrencia aplicada; va junto con scheduleId." },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      }
    },

    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "accountId", "amount", "description", "frequency", "startDate", "mode", "skippedDates", "createdAt"],
      "properties": {
        "id": { "$ref": "#/$defs/scheduleId" },
        "type": { "enum": ["ingreso", "gasto", "transferencia"] },
        "accountId": { "$ref": "#/$defs/accountId" },
        "toAccountId": { "$ref": "#/$defs/accountId", "description": "Solo transferencia." },
        "categoryId": { "$ref": "#/$defs/categoryId", "description": "Solo ingreso y gasto." },
        "amount": { "$ref": "#/$defs/positiveMoney", "description": "Monto de cada ocurrencia." },
        "description": { "type": "string", "minLength": 1, "maxLength": 80 },
        "frequency": { "enum": ["once", "monthly", "biweekly"] },
        "startDate": { "$ref": "#/$defs/isoDate" },
        "endDate": { "$ref": "#/$defs/isoDate", "description": "Opcional; no aplica a 'once'." },
        "mode": { "enum": ["auto", "manual"] },
        "skippedDates": { "type": "array", "items": { "$ref": "#/$defs/isoDate" }, "uniqueItems": true },
        "createdAt": { "$ref": "#/$defs/dateTime" }
      }
    }
  }
}
